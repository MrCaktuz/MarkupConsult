{
  "name": "markup-consult",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prepare": "husky install",
    "check:types": "tsc --pretty --noEmit",
    "check:format": "prettier --check ./src",
    "check:lint": "eslint --ignore-pattern 'node_modules/*' --ignore-pattern '.next/*' ./src",
    "check:style": "stylelint 'src/**/*.{scss,css}'",
    "check:all": "pnpm check:format && pnpm check:lint && pnpm check:types && pnpm check:style && pnpm build",
    "fix:style": "stylelint --fix 'src/**/*.{scss,css}'",
    "fix:format": "prettier --write ./src",
    "fix:lint": "eslint --fix --ignore-pattern 'node_modules/*' --ignore-pattern '.next/*' ./src",
    "fix:all": "pnpm fix:format && pnpm fix:lint && pnpm fix:style"
  },
  "dependencies": {
    "next": "^15.5.27",
    "puppeteer-core": "^24.43.1",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.27",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-unicorn": "^58.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-order": "^7.0.1",
    "stylelint-scss": "^6.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a"
